# Cache rules for Cloudflare Workers static assets.
# Astro puts a content hash in each file name in /_astro/, so these files do not change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The Parquet files change when we rebuild the database.
/data/*
  Cache-Control: public, max-age=3600

# DuckDB-WASM files (scripts/sync-site-duckdb.ts). The path has the npm version
# (/duckdb/<npm version>/) or the DuckDB version (/duckdb/extensions/<version>/),
# so the files do not change.
/duckdb/*
  Cache-Control: public, max-age=31536000, immutable

# The page decompresses the .wasm.gz files itself. Send them as plain bytes,
# with no Content-Encoding header.
/duckdb/*.gz
  Content-Type: application/octet-stream
