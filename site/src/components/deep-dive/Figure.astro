---
// Build-time figure of a Deep Dive, caption and a link to the data page with the same sites,
// variables and period. Two forms:
// 1. TypeScript dive: `svg`, `alt` and `title`. The SVG comes from site/src/lib/deepDiveChart.ts
//    (renderSvg) and has role="img" with an aria-label (= alt text). The caption is the slot.
// 2. Python dive: `svgFile`, the repository path of a matplotlib SVG (analysis/<slug>/figures/<n>-<name>.svg).
//    The SVG has role="img", aria-labelledby, and <title id> and <desc id> as the first two children.
//    The component puts the SVG in the page without changes, shows <title> as the caption and <desc>
//    as the text description, and adds a download link (scripts/sync-site-data.ts copies the file
//    to site/public/deep-dive/<slug>/). Rules: CLAUDE.md, "Python analysis scripts" → "Site integration".
import { readFileSync } from 'node:fs';
import { baseUrl, dataPageHref, type DataLink } from '../../lib/deepDive';

interface Props {
  id: string;
  /** Form 1: figure number and title, for example "Figure 1. Mean daily fluxes around the events". */
  title?: string;
  /** Form 1: the SVG text. */
  svg?: string;
  /** Form 1: the alt text of the SVG; the page shows it below the caption too. */
  alt?: string;
  /** Form 2: repository path of a matplotlib SVG, for example analysis/<slug>/figures/1-<name>.svg. */
  svgFile?: string;
  /** View of the data page for the link. */
  view?: DataLink;
}
const { id, title, svg, alt, svgFile, view } = Astro.props;
const base = baseUrl();

/** Decode the XML entities of a text node. */
function xmlText(s: string): string {
  return s
    .replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, '$1')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&#(\d+);/g, (_, n: string) => String.fromCodePoint(Number(n)))
    .replace(/&#x([0-9a-f]+);/gi, (_, n: string) => String.fromCodePoint(parseInt(n, 16)))
    .replace(/&amp;/g, '&')
    .replace(/\s+/g, ' ')
    .trim();
}

let html: string;
let caption: string;
let description: string;
let download: string | null = null;
if (svgFile !== undefined) {
  if (svg !== undefined || alt !== undefined || title !== undefined) {
    throw new Error(`Deep Dive figure ${id}: give svgFile, or svg, alt and title; not both forms`);
  }
  const m = /^analysis\/([a-z0-9-]+)\/figures\/([^/]+\.svg)$/.exec(svgFile);
  if (!m) throw new Error(`Deep Dive figure ${id}: svgFile must be analysis/<slug>/figures/<file>.svg, not ${svgFile}`);
  // The component is at site/src/components/deep-dive/: the repository root is four levels up.
  const root = new URL('../../../../', import.meta.url);
  let text: string;
  try {
    text = readFileSync(new URL(svgFile, root), 'utf8');
  } catch (e) {
    throw new Error(`Deep Dive figure ${id}: cannot read ${svgFile}: ${(e as Error).message}`);
  }
  html = text.replace(/^﻿/, '').replace(/^\s*<\?xml[^>]*\?>\s*/, '').replace(/^\s*<!DOCTYPE[^>]*>\s*/i, '');
  const open = /<svg\b[^>]*>/.exec(html);
  if (!open) throw new Error(`Deep Dive figure ${id}: ${svgFile} has no <svg> element`);
  const tag = open[0];
  const labelledby = /\saria-labelledby="([^"]+)"/.exec(tag)?.[1];
  if (!/\srole="img"/.test(tag) || !labelledby) {
    throw new Error(`Deep Dive figure ${id}: the <svg> element of ${svgFile} needs role="img" and aria-labelledby`);
  }
  // The first two children of <svg> must be <title id> and <desc id>.
  const after = html.slice(open.index + tag.length);
  const children = /^\s*<title\s+id="([^"]+)"\s*>([\s\S]*?)<\/title>\s*<desc\s+id="([^"]+)"\s*>([\s\S]*?)<\/desc>/.exec(after);
  if (!children) {
    throw new Error(`Deep Dive figure ${id}: the first two children of <svg> in ${svgFile} must be <title id="…"> and <desc id="…">`);
  }
  const [, titleId, titleText, descId, descText] = children;
  const ids = labelledby.trim().split(/\s+/);
  if (!ids.includes(titleId!) || !ids.includes(descId!)) {
    throw new Error(`Deep Dive figure ${id}: aria-labelledby="${labelledby}" in ${svgFile} must name the <title> id ${titleId} and the <desc> id ${descId}`);
  }
  caption = xmlText(titleText!);
  description = xmlText(descText!);
  if (!caption || !description) throw new Error(`Deep Dive figure ${id}: <title> and <desc> of ${svgFile} must not be empty`);
  // The file name starts with the figure number: the caption gets "Figure <n>." as in the TypeScript dives.
  const num = /^(\d+)-/.exec(m[2]!);
  if (num) caption = `Figure ${num[1]}. ${caption}`;
  download = `${base}deep-dive/${m[1]}/${m[2]}`;
} else {
  if (svg === undefined || alt === undefined || title === undefined) {
    throw new Error(`Deep Dive figure ${id}: give svgFile, or svg, alt and title`);
  }
  if (!/role="img"/.test(svg) || !/aria-label="[^"]+"/.test(svg)) throw new Error(`Deep Dive figure ${id}: the SVG needs role="img" and an aria-label`);
  html = svg;
  caption = title;
  description = alt;
}
const href = view ? dataPageHref(base, view) : null;
---

<figure class="dd-figure" id={id}>
  {
    svgFile !== undefined ? (
      <div class="dd-figure-wrap figure-mpl">
        <Fragment set:html={html} />
      </div>
    ) : (
      <div class="dd-figure-wrap">
        <Fragment set:html={html} />
      </div>
    )
  }
  <figcaption>
    <p class="dd-figure-title"><strong>{caption}</strong></p>
    <slot />
    <details class="dd-alt">
      <summary>Text description of the figure</summary>
      <p>{description}</p>
    </details>
    {href && <p class="dd-figure-link"><a href={href}>Open in the data page</a> ({view!.name})</p>}
    {download && <p class="dd-figure-link dd-figure-download"><a href={download} download>Download SVG</a></p>}
  </figcaption>
</figure>
