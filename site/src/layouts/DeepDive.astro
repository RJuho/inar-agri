---
// Layout of one Deep Dive (site/src/pages/deep-dive/<slug>.mdx, frontmatter `layout`).
// It checks the frontmatter (Valibot), the result JSON, the fixed h2 structure and the citation
// links; an error stops the build. It writes the h1, the AI notice, the facts box and the
// "Question" section; the MDX body has the other sections. Rules: CLAUDE.md, section "Deep Dive".
import '../styles/deep-dive.css';
import Base from './Base.astro';
import AiNotice from '../components/AiNotice.astro';
import { baseUrl, CHECKED_NOTE, checkBody, diveData, diveLabel, parseFrontmatter, SITE_NAMES, slugFromFile } from '../lib/deepDive';
import { REPO_URL } from '../lib/dataReport';
import { VARIABLE_LABELS } from '../scripts/state';

interface Props {
  frontmatter: unknown;
  file: string;
}

const { frontmatter, file } = Astro.props;
const slug = slugFromFile(file);
const fm = parseFrontmatter(frontmatter, slug);
const data = diveData(slug);
const version = data.dataVersion;
const body = await Astro.slots.render('default');
checkBody(body, slug);

const base = baseUrl();
const time = (iso: string | null | undefined) => (iso ? iso.replace('T', ' ').replace(/:\d\d(\.\d+)?Z$/, ' UTC') : '–');
const statusText = fm.status === 'checked' ? 'Checked' : 'Draft';
---

<Base title={`${fm.title} – Deep Dive – INAR agri`} description={fm.question}>
  <main class="prose deep-dive">
    <header>
      <p class="dd-kicker"><a href={`${base}deep-dive/`}>Deep Dives</a> · <span class="dd-index">{diveLabel(fm.index)}</span></p>
      <h1>{fm.title}</h1>
      <AiNotice subject="the question, the analysis script, the text and the figures" />
      <dl class="dd-facts">
        <div>
          <dt>Status</dt>
          <dd>
            <span class={`dd-status dd-status-${fm.status}`}>{statusText}</span>
            {
              fm.status === 'draft' ? (
                <span class="dd-status-note">No independent check yet. Do not use the numbers without a check.</span>
              ) : (
                <span class="dd-status-note">{CHECKED_NOTE}</span>
              )
            }
          </dd>
        </div>
        <div><dt>Number</dt><dd>{fm.index} (order of creation, 0 = first dive)</dd></div>
        <div><dt>Sites</dt><dd>{fm.sites.map((s) => SITE_NAMES[s]).join(', ')}</dd></div>
        <div><dt>Variables</dt><dd>{fm.variables.map((v) => VARIABLE_LABELS[v]).join('; ')}</dd></div>
        <div><dt>Period</dt><dd>{fm.period.from} to {fm.period.to}</dd></div>
        <div><dt>Date</dt><dd><time datetime={fm.date}>{fm.date}</time></dd></div>
        <div>
          <dt>Models</dt>
          <dd>
            <ul>{fm.models.map((m) => <li>{m.model}: {m.role}</li>)}</ul>
          </dd>
        </div>
        <div>
          <dt>Checks</dt>
          <dd>
            {
              fm.checks.length === 0 ? (
                'None yet.'
              ) : (
                <ul>
                  {fm.checks.map((c) => (
                    <li>
                      {c.kind === 'recompute' ? 'Independent recompute' : 'Language and reference review'} by {c.by} ({c.date}): {c.result}. {c.note}
                    </li>
                  ))}
                </ul>
              )
            }
          </dd>
        </div>
        <div>
          <dt>Script</dt>
          <dd><a href={`${REPO_URL}/blob/main/${fm.script}`} rel="noopener"><code>{fm.script}</code></a></dd>
        </div>
        <div>
          <dt>Data version</dt>
          <dd>
            Results of {time(version?.generatedAt)}, code commit <code>{version?.git.commit ?? '–'}</code>{version?.git.dirty && ' (with uncommitted changes)'}.
            Database built {time(version?.dbBuiltAt)}, calculated data built {time(version?.calcBuiltAt)}.
          </dd>
        </div>
      </dl>
    </header>

    <h2 id="question">Question</h2>
    <p class="dd-question">{fm.question}</p>

    <Fragment set:html={body} />
  </main>
</Base>
