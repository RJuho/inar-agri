---
// Shared page frame: <head>, styles, the page navigation, the footer and the update check.
import '../styles/global.css';
import '../styles/calculated.css';
import { REPO_URL } from '../lib/dataReport';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname.replace(/\/?$/, '/');
const pages = [
  { href: base, label: 'Data' },
  { href: `${base}calculated/`, label: 'Calculated' },
  { href: `${base}variables/`, label: 'Variables' },
  { href: `${base}events/`, label: 'Events' },
  { href: `${base}data-report/`, label: 'Data Report' },
  { href: `${base}deep-dive/`, label: 'Deep Dives' },
];
/** aria-current of a page link: 'page' on its own page, 'true' on a sub-page (for example one Deep Dive). */
const current = (href: string) => (path === href ? 'page' : href !== base && path.startsWith(href) ? 'true' : undefined);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    <nav class="page-nav" aria-label="Pages">
      <ul>
        {
          pages.map((p) => (
            <li>
              <a href={p.href} aria-current={current(p.href)}>
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <slot />
    <footer class="site-footer">
      <p>
        Source code: <a href={REPO_URL} rel="noopener">{REPO_URL.replace(/^https:\/\//, '')}</a>
      </p>
    </footer>
    <script>
      // All pages: show a notice when a new build of the site is online.
      import { startUpdateCheck } from '../scripts/update';
      startUpdateCheck();
    </script>
  </body>
</html>
